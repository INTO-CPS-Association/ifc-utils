{
  "name": "@into-cps-association/bim-ifc-converter",
  "version": "0.2.1",
  "description": "Turn an IFC file into drawable geometry and a property tree, in the browser.",
  "keywords": [
    "ifc",
    "bim",
    "glb",
    "gltf",
    "web-ifc",
    "dtaas"
  ],
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://github.com/INTO-CPS-Association/ifc-utils/tree/main/packages/bim-ifc-converter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTO-CPS-Association/ifc-utils.git",
    "directory": "packages/bim-ifc-converter"
  },
  "bugs": "https://github.com/INTO-CPS-Association/ifc-utils/issues",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "scripts": {
    "build": "node scripts/inline-wasm.mjs && tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json --noEmit && node --test 'test/*.test.mjs'",
    "audit": "npm audit --audit-level=high",
    "prepack": "node ../bim-glb-viewer/scripts/licence.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "web-ifc": "0.0.77"
  },
  "peerDependencies": {
    "three": ">=0.160.0"
  },
  "devDependencies": {
    "@types/three": "0.185.4",
    "three": "0.185.0",
    "typescript": "5.9.3"
  }
}
